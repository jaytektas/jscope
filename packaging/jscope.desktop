[Desktop Entry]
Type=Application
Version=1.0
Name=JScope
GenericName=Oscilloscope
Comment=Hantek 1008C and DSO2D15 oscilloscope front end
Exec=/home/jay/workspace/hantek/build/jscope
Icon=jscope
Terminal=false
Categories=Development;Electronics;Engineering;
Keywords=oscilloscope;scope;hantek;waveform;trace;
StartupNotify=true
# JScope sets its OWN WM_CLASS at startup — see src/app/JScopeWindowIdentity.cpp.
#
# JFramework gives every application it builds the class "genesis-ui"/"GenesisUi"
# and no way to change it, so without that the running window showed as
# "genesisui" in the dock and in alt-tab, and was indistinguishable from any
# other JFramework application on the machine. Naming that shared class here
# would have matched those windows too.
#
# The application sets jscope/JScope on its own window instead, which this entry
# can then match without capturing anything else.
StartupWMClass=JScope
